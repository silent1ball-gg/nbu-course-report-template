{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build LaTeX paper",
      "type": "shell",
      "command": "latexmk",
      "args": [
        "-cd",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-xelatex",
        "-outdir=build",
        "${workspaceFolder}/main.tex"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
